{
  "schemaVersion": 1,
  "id": "community.steam_import_node",
  "name": "Steam Import Node Provider",
  "version": "0.3.1",
  "description": "Import installed Steam games and owned/family-shared account games, sign in with a dedicated browser profile, and launch Steam games.",
  "logoPath": "logo.svg",
  "protocol": "json-rpc/1",
  "runtime": {
    "kind": "node",
    "version": "22.22.0"
  },
  "entry": "runtime/provider.mjs",
  "capabilities": [
    {
      "providerId": "community.steam_import_node.import",
      "capability": "import.library",
      "action": "discover"
    },
    {
      "providerId": "community.steam_import_node.import",
      "capability": "imports.detectLibraries",
      "action": "detect-libraries"
    },
    {
      "providerId": "community.steam_import_node.import",
      "capability": "imports.readCandidates",
      "action": "read-candidates"
    },
    {
      "providerId": "community.steam_import_node.account",
      "capability": "accounts.readCandidates",
      "action": "read-account-candidates"
    },
    {
      "providerId": "community.steam_import_node.account",
      "capability": "accounts.status",
      "action": "account-status"
    },
    {
      "providerId": "community.steam_import_node.account",
      "capability": "accounts.login",
      "action": "login"
    },
    {
      "providerId": "community.steam_import_node.launch",
      "capability": "launch.resolveProvider",
      "action": "resolve-launch"
    },
    {
      "providerId": "community.steam_import_node.launch",
      "capability": "launch.requestProvider",
      "action": "request-launch"
    }
  ],
  "actions": [
    {
      "id": "discover",
      "inputSchema": "import.input/1",
      "resultSchema": "import.result/1",
      "hostMethods": []
    },
    {
      "id": "detect-libraries",
      "inputSchema": "imports.detectLibraries/1",
      "resultSchema": "imports.detectLibraries/1",
      "hostMethods": []
    },
    {
      "id": "read-candidates",
      "inputSchema": "imports.readCandidates/1",
      "resultSchema": "imports.readCandidates/1",
      "hostMethods": []
    },
    {
      "id": "read-account-candidates",
      "inputSchema": "accounts.readCandidates/1",
      "resultSchema": "accounts.readCandidates/1",
      "hostMethods": []
    },
    {
      "id": "account-status",
      "inputSchema": "accounts.status/1",
      "resultSchema": "accounts.status/1",
      "hostMethods": []
    },
    {
      "id": "login",
      "inputSchema": "accounts.login/1",
      "resultSchema": "accounts.login/1",
      "hostMethods": []
    },
    {
      "id": "resolve-launch",
      "inputSchema": "launch.resolveProvider/1",
      "resultSchema": "launch.resolveProvider/1",
      "hostMethods": []
    },
    {
      "id": "request-launch",
      "inputSchema": "launch.requestProvider/1",
      "resultSchema": "launch.requestProvider/1",
      "hostMethods": []
    }
  ],
  "providers": [
    {
      "id": "community.steam_import_node.import",
      "name": "Steam Installed Games",
      "familyId": "steam"
    },
    {
      "id": "community.steam_import_node.account",
      "name": "Steam Account and Family Library",
      "familyId": "steam"
    },
    {
      "id": "community.steam_import_node.launch",
      "name": "Steam URL Launch",
      "familyId": "steam"
    }
  ]
}
